# ---------- Polyhouse OS settings ----------
# Copy this file to .env (local) or add the same keys in your host's "Environment" screen.

PORT=4000
NODE_ENV=development

# MySQL - either DATABASE_URL ...
# DATABASE_URL=mysql://user:password@host:3306/polyhouse_os
# ... or the separate values:
DB_HOST=localhost
DB_PORT=3306
DB_USER=poly
DB_PASSWORD=poly123
DB_NAME=polyhouse_os
# Cloud MySQL (TiDB Cloud / Aiven) needs TLS:
DB_SSL=false
# DB_SSL_VERIFY=false      # only if your provider uses a self-signed certificate
# DB_SSL_CA=/path/ca.pem   # Aiven: download the CA certificate and point to it

# Long random string - keeps logins secure. Change it in production!
JWT_SECRET=change-this-to-a-long-random-string

# Super admin (you) - created automatically on first start if no super admin exists
SUPERADMIN_LOGIN=superadmin
SUPERADMIN_PASSWORD=admin123

# true = show one-tap demo logins on the login page (needs `npm run db:reset` demo data)
DEMO_MODE=true
